{
  "name": "resume_maker",
  "version": "1.0.0",
  "description": "Generate job-hunting documents (resume, cover letter, LinkedIn guide, interview prep) from structured data to Markdown + PDF formats",
  "keywords": [
    "resume",
    "cv",
    "markdown",
    "pdf",
    "job-hunting",
    "cover-letter",
    "linkedin"
  ],
  "license": "MIT",
  "author": "Alexander Iseghohi",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "bun index.ts",
    "help": "bun index.ts --help",
    "lint": "node node_modules/eslint/bin/eslint.js index.ts *.json && node node_modules/prettier/bin/prettier.cjs --check \"*.ts\" \"*.json\" \"*.md\" \"!node_modules/**\"",
    "lint:fix": "node node_modules/eslint/bin/eslint.js index.ts *.json --fix && node node_modules/prettier/bin/prettier.cjs --write \"*.ts\" \"*.json\" \"*.md\" \"!node_modules/**\"",
    "lint:md": "node node_modules/markdownlint-cli2/markdownlint-cli2-bin.mjs --config .markdownlint.json \"*.md\" \"!node_modules/**\"",
    "lint:spell": "node node_modules/cspell/bin.mjs \"*.ts\" \"*.md\" \"*.json\"",
    "start": "bun index.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "markdown-pdf": "^11.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "cspell": "^10.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14"
}
